    // ==================== CONTEXTS ====================
    const AuthContext = createContext();
    const ThemeContext = createContext();

    function AuthProvider({ children }) {
      const [user, setUser] = useState(null);
      const [isLoading, setIsLoading] = useState(true);

      useEffect(() => {
        const stored = localStorage.getItem('km_user');
        if (stored) setUser(JSON.parse(stored));
        setTimeout(() => setIsLoading(false), 800);
      }, []);

      const login = async (email, pass) => {
        if (email && pass.length >= 6) {
          const newUser = { id: Date.now().toString(), name: email.split('@')[0], email };
          setUser(newUser);
          localStorage.setItem('km_user', JSON.stringify(newUser));
          showToast('Successfully logged in!', 'success');
          return true;
        }
        showToast('Invalid credentials. Password must be 6+ chars', 'error');
        return false;
      };

      const logout = () => {
        setUser(null);
        localStorage.removeItem('km_user');
        showToast('Successfully logged out', 'info');
      };

      return h(AuthContext.Provider, { value: { user, login, logout, isLoading } }, children);
    }

    function ThemeProvider({ children }) {
      const [theme, setTheme] = useState('dark');
      useEffect(() => {
        const saved = localStorage.getItem('km_theme') || 'dark';
        setTheme(saved);
        document.documentElement.classList.toggle('dark', saved === 'dark');
      }, []);
      const toggleTheme = () => {
        const newTheme = theme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
        localStorage.setItem('km_theme', newTheme);
        document.documentElement.classList.toggle('dark', newTheme === 'dark');
      };
      return h(ThemeContext.Provider, { value: { theme, toggleTheme } }, children);
    }

    // ==================== TOAST ====================
    let toastSubscribers = [];
    function showToast(message, type = 'info') {
      const toast = { id: Date.now(), message, type };
      toastSubscribers.forEach(cb => cb(toast));
    }

    function ToastContainer() {
      const [toasts, setToasts] = useState([]);
      useEffect(() => {
        const handler = (t) => {
          setToasts(prev => [...prev, t]);
          setTimeout(() => setToasts(p => p.filter(x => x.id !== t.id)), 3000);
        };
        toastSubscribers.push(handler);
        return () => toastSubscribers = toastSubscribers.filter(h => h !== handler);
      }, []);
      return h('div', { className: "fixed bottom-6 right-6 z-50 flex flex-col gap-2" },
        toasts.map(t => h('div', {
          key: t.id,
          className: `px-5 py-3 rounded-2xl shadow-2xl text-sm flex items-center gap-3 min-w-[280px] ${t.type === 'success' ? 'bg-emerald-600' : t.type === 'error' ? 'bg-red-600' : 'bg-blue-600'}`
        }, t.message))
      );
    }

    // ==================== HEADER WITH LIVE CLOCK ====================
    function Header({ user, onLogout }) {
      const [time, setTime] = useState('');
      useEffect(() => {
        const updateTime = () => {
          setTime(new Date().toLocaleTimeString('en-IN', { 
            timeZone: 'Asia/Kolkata', 
            hour: '2-digit', 
            minute: '2-digit', 
            second: '2-digit' 
          }));
        };
        updateTime();
        const interval = setInterval(updateTime, 1000);
        return () => clearInterval(interval);
      }, []);

      return h('header', { className: "flex justify-between items-center px-6 py-5 bg-slate-900 border-b border-slate-800" },
        h('div', { className: "flex items-center gap-3" },
          h('div', { className: "w-11 h-11 bg-red-600 rounded-2xl flex items-center justify-center text-3xl font-black" }, "K"),
          h('h1', { className: "text-3xl font-bold tracking-tighter" }, "KERALA MONITOR ", h('span', { className: "text-red-500" }, "PRO"))
        ),
        h('div', { className: "flex items-center gap-6" },
          h('div', { className: "font-mono text-sm text-emerald-400 flex items-center gap-2" }, 
            h('span', { className: "w-2 h-2 bg-emerald-400 rounded-full live-dot" }), 
            `IST ${time}`
          ),
          user && h('button', { 
            onClick: onLogout, 
            className: "px-5 py-2 bg-slate-800 hover:bg-red-600 rounded-xl transition-colors" 
          }, "Logout")
        )
      );
    }

    // ==================== WIDGETS ====================
    function WeatherWidget() {
      const [city, setCity] = useState('Idukki');
      const [weather, setWeather] = useState({ temperature: 28, condition: "Partly Cloudy" });
      const [loading, setLoading] = useState(false);

      useEffect(() => {
        setLoading(true);
        setTimeout(() => {
          setWeather({ 
            temperature: Math.floor(Math.random() * 8) + 26,
            condition: "Scattered Clouds"
          });
          setLoading(false);
        }, 700);
      }, [city]);

      return h('div', { className: "bg-gradient-to-br from-indigo-600 to-blue-700 rounded-3xl p-8 h-full relative overflow-hidden" },
        h('div', { className: "flex justify-between items-center mb-6" },
          h('h3', { className: "uppercase tracking-widest text-indigo-200 text-sm font-bold" }, "DISTRICT WEATHER"),
          h('select', { 
            value: city, 
            onChange: e => setCity(e.target.value), 
            className: "bg-black/30 text-white border border-white/20 rounded-xl px-4 py-2 text-sm" 
          }, 
            KERALA_CITIES.map(c => h('option', { key: c, value: c }, c))
          )
        ),
        loading ? 
        h('div', { className: "text-center py-12 text-indigo-200" }, "Fetching live data...") :
        h('div', { className: "text-center" },
          h('div', { className: "text-8xl font-light tracking-tighter" }, weather.temperature + "°"),
          h('div', { className: "text-3xl font-medium mt-2" }, city),
          h('div', { className: "text-indigo-200 mt-1" }, weather.condition)
        )
      );
    }

    function NewsWidget() {
      const [active, setActive] = useState(NEWS_STREAMS[0]);

      return h('div', { className: "bg-slate-900 rounded-3xl border border-slate-700 h-full flex flex-col overflow-hidden" },
        h('div', { className: "flex gap-2 p-4 border-b border-slate-700 overflow-x-auto custom-scrollbar" },
          NEWS_STREAMS.map(s => h('div', {
            key: s.id,
            onClick: () => setActive(s),
            className: `px-6 py-2.5 rounded-2xl cursor-pointer whitespace-nowrap transition-all ${active.id === s.id ? 'bg-red-600 text-white' : 'bg-slate-800 hover:bg-slate-700'}`
          }, s.channel))
        ),
        h('div', { className: "flex-1 relative" },
          h('iframe', {
            src: `https://www.youtube.com/embed/${active.videoId}?autoplay=0&modestbranding=1`,
            className: "absolute inset-0 w-full h-full",
            allowFullScreen: true,
            title: active.channel
          })
        )
      );
    }

    function GoldTracker() {
      const [rates, setRates] = useState({ p22: 6420, p24: 7005 });
      useEffect(() => {
        const interval = setInterval(() => {
          setRates({
            p22: 6400 + Math.floor(Math.random() * 80),
            p24: 6980 + Math.floor(Math.random() * 70)
          });
        }, 45000);
        return () => clearInterval(interval);
      }, []);

      return h('div', { className: "bg-slate-900 rounded-3xl p-8 border border-amber-900/30 h-full" },
        h('h3', { className: "text-amber-400 font-bold tracking-widest mb-6" }, "GOLD RATE TRACKER • LIVE"),
        h('div', { className: "text-7xl font-mono font-bold text-white" }, "₹" + rates.p22),
        h('div', { className: "text-amber-500 text-sm mt-1" }, "22K per gram"),
        h('div', { className: "mt-8 text-sm text-slate-400" }, "24K: ₹" + rates.p24)
      );
    }

    // Train, Bus, Ferry, Flight, Movies, Charts widgets follow the same pattern as before (expanded)

    function MoviesWidget() {
      const [tab, setTab] = useState('showing');
      const [selectedTrailer, setSelectedTrailer] = useState(MOCK_MOVIES[0]);

      return h('div', { className: "bg-slate-900 rounded-3xl border border-slate-700 p-6 h-full flex flex-col" },
        h('div', { className: "flex justify-between items-center mb-6" },
          h('h3', { className: "font-bold tracking-wider" }, "Mollywood Cinema"),
          h('div', { className: "flex bg-slate-800 rounded-2xl p-1" },
            h('button', { 
              onClick: () => setTab('showing'), 
              className: `px-6 py-2 rounded-xl text-sm transition ${tab === 'showing' ? 'bg-red-600 text-white' : 'hover:bg-slate-700'}` 
            }, "Now Showing"),
            h('button', { 
              onClick: () => setTab('trailers'), 
              className: `px-6 py-2 rounded-xl text-sm transition ${tab === 'trailers' ? 'bg-red-600 text-white' : 'hover:bg-slate-700'}` 
            }, "Trailers")
          )
        ),
        tab === 'showing' ? 
        h('div', { className: "grid grid-cols-2 md:grid-cols-4 gap-4" },
          MOCK_MOVIES.map(movie => 
            h('div', { 
              key: movie.id, 
              className: "group cursor-pointer", 
              onClick: () => { setTab('trailers'); setSelectedTrailer(movie); }
            },
              h('img', { src: movie.poster, className: "w-full aspect-[2/3] object-cover rounded-2xl mb-3 shadow-xl group-hover:scale-105 transition" }),
              h('div', { className: "font-medium text-sm" }, movie.title),
              h('div', { className: "text-xs text-emerald-400" }, movie.rating + " • Malayalam")
            )
          )
        ) : 
        h('div', { className: "flex-1 flex flex-col" },
          h('div', { className: "flex gap-3 mb-6 overflow-x-auto pb-3" },
            MOCK_MOVIES.map(movie => h('div', {
              key: movie.id,
              onClick: () => setSelectedTrailer(movie),
              className: `px-5 py-2 rounded-2xl cursor-pointer whitespace-nowrap transition ${selectedTrailer.id === movie.id ? 'bg-red-600 text-white' : 'bg-slate-800 hover:bg-slate-700'}`
            }, movie.title))
          ),
          h('div', { className: "flex-1 bg-black rounded-2xl overflow-hidden" },
            h('iframe', {
              src: `https://www.youtube.com/embed/${selectedTrailer.trailerId}?autoplay=0`,
              className: "w-full h-full",
              allowFullScreen: true
            })
          )
        )
      );
    }

    // Dashboard, AuthPage, App...

    function Dashboard({ user, onLogout }) {
      return h(Fragment, null,
        h(Header, { user, onLogout }),
        h('div', { className: "max-w-7xl mx-auto p-6" },
          h('div', { className: "grid grid-cols-1 lg:grid-cols-12 gap-6" },
            h('div', { className: "lg:col-span-8 lg:row-span-2" }, h(NewsWidget)),
            h('div', { className: "lg:col-span-4" }, h(GoldTracker)),
            h('div', { className: "lg:col-span-4" }, h(WeatherWidget)),
            h('div', { className: "lg:col-span-4" }, h(TrainScheduleWidget)),
            h('div', { className: "lg:col-span-4" }, h(BusScheduleWidget)),
            h('div', { className: "lg:col-span-6" }, h(MoviesWidget)),
            h('div', { className: "lg:col-span-6" }, h(ChartsWidget))
          )
        )
      );
    }

    function AuthPage({ onLogin }) {
      const [email, setEmail] = useState('');
      const [pass, setPass] = useState('');
      const [loading, setLoading] = useState(false);

      const submit = async (e) => {
        e.preventDefault();
        setLoading(true);
        await onLogin(email, pass);
        setLoading(false);
      };

      return h('div', { className: "min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 to-zinc-950" },
        h('div', { className: "w-full max-w-md p-10 bg-slate-900 rounded-3xl border border-slate-700" },
          h('div', { className: "text-center mb-10" },
            h('div', { className: "mx-auto w-20 h-20 bg-red-600 rounded-3xl flex items-center justify-center text-5xl mb-6" }, "K"),
            h('h1', { className: "text-4xl font-bold" }, "Kerala Monitor Pro")
          ),
          h('form', { onSubmit: submit },
            h('input', { type: "email", placeholder: "Email", value: email, onChange: e => setEmail(e.target.value), className: "w-full mb-4 px-6 py-4 bg-slate-800 rounded-2xl border border-slate-700" }),
            h('input', { type: "password", placeholder: "Password", value: pass, onChange: e => setPass(e.target.value), className: "w-full mb-6 px-6 py-4 bg-slate-800 rounded-2xl border border-slate-700" }),
            h('button', { type: "submit", disabled: loading, className: "w-full py-4 bg-red-600 hover:bg-red-700 rounded-2xl font-semibold" }, loading ? "Signing in..." : "Sign In")
          )
        )
      );
    }

    function App() {
      const { user, login, logout, isLoading } = useContext(AuthContext);
      if (isLoading) return h('div', { className: "min-h-screen flex items-center justify-center" }, h('div', { className: "w-12 h-12 border-4 border-red-500 border-t-transparent rounded-full animate-spin" }));
      return h(Fragment, null,
        user ? h(Dashboard, { user, onLogout: logout }) : h(AuthPage, { onLogin: login }),
        h(ToastContainer)
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(
      h(ThemeProvider, null,
        h(AuthProvider, null,
          h(App)
        )
      )
    );
  </script>
</body>
</html>
