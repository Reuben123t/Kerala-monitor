    // ==================== CONTEXTS ====================
    const AuthContext = createContext();
    const ThemeContext = createContext();

    function AuthProvider({ children }) {
      const [user, setUser] = useState(null);
      const [isLoading, setIsLoading] = useState(true);

      useEffect(() => {
        const stored = localStorage.getItem('km_user');
        if (stored) setUser(JSON.parse(stored));
        setTimeout(() => setIsLoading(false), 800);
      }, []);

      const login = async (email, pass) => {
        if (email && pass.length >= 6) {
          const newUser = { id: Date.now().toString(), name: email.split('@')[0], email };
          setUser(newUser);
          localStorage.setItem('km_user', JSON.stringify(newUser));
          showToast('Successfully logged in!', 'success');
          return true;
        }
        showToast('Invalid credentials', 'error');
        return false;
      };

      const logout = () => {
        setUser(null);
        localStorage.removeItem('km_user');
        showToast('Successfully logged out', 'info');
      };

      return h(AuthContext.Provider, { value: { user, login, logout, isLoading } }, children);
    }

    function ThemeProvider({ children }) {
      const [theme, setTheme] = useState('dark');
      useEffect(() => {
        const saved = localStorage.getItem('km_theme') || 'dark';
        setTheme(saved);
        document.documentElement.classList.toggle('dark', saved === 'dark');
      }, []);
      const toggleTheme = () => {
        const newTheme = theme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
        localStorage.setItem('km_theme', newTheme);
        document.documentElement.classList.toggle('dark', newTheme === 'dark');
      };
      return h(ThemeContext.Provider, { value: { theme, toggleTheme } }, children);
    }

    // ==================== TOAST ====================
    let toastSubscribers = [];
    function showToast(message, type = 'info') {
      const toast = { id: Date.now(), message, type };
      toastSubscribers.forEach(cb => cb(toast));
    }

    function ToastContainer() {
      const [toasts, setToasts] = useState([]);
      useEffect(() => {
        const handler = (t) => {
          setToasts(prev => [...prev, t]);
          setTimeout(() => setToasts(p => p.filter(x => x.id !== t.id)), 3000);
        };
        toastSubscribers.push(handler);
        return () => toastSubscribers = toastSubscribers.filter(h => h !== handler);
      }, []);
      return h('div', { className: "fixed bottom-6 right-6 z-50 flex flex-col gap-2" },
        toasts.map(t => h('div', {
          key: t.id,
          className: `px-5 py-3 rounded-2xl shadow-2xl text-sm flex items-center gap-3 min-w-[280px] ${t.type === 'success' ? 'bg-emerald-600' : t.type === 'error' ? 'bg-red-600' : 'bg-blue-600'}`
        }, t.message))
      );
    }

    // ==================== HEADER WITH LIVE CLOCK ====================
    function Header({ user, onLogout }) {
      const [time, setTime] = useState('');

      useEffect(() => {
        const updateTime = () => {
          setTime(new Date().toLocaleTimeString('en-IN', { 
            timeZone: 'Asia/Kolkata', 
            hour: '2-digit', 
            minute: '2-digit',
            second: '2-digit'
          }));
        };
        updateTime();
        const interval = setInterval(updateTime, 1000);
        return () => clearInterval(interval);
      }, []);

      return h('header', { className: "flex justify-between items-center px-6 py-5 bg-slate-900 border-b border-slate-800" },
        h('div', { className: "flex items-center gap-3" },
          h('div', { className: "w-11 h-11 bg-red-600 rounded-2xl flex items-center justify-center text-3xl font-black" }, "K"),
          h('h1', { className: "text-3xl font-bold tracking-tighter" }, "KERALA MONITOR ", h('span', { className: "text-red-500" }, "PRO"))
        ),
        h('div', { className: "flex items-center gap-6" },
          h('div', { className: "font-mono text-sm text-emerald-400" }, `IST ${time}`),
          user && h('div', { className: "flex items-center gap-4" },
            h('span', { className: "text-slate-400" }, user.name),
            h('button', { onClick: onLogout, className: "px-5 py-2 bg-slate-800 hover:bg-red-600 rounded-xl transition" }, "Logout")
          )
        )
      );
    }

    // ==================== ALL WIDGETS (Weather, News, Gold, Train, Bus, Ferry, Flight, Movies, Charts) ====================
    // ... (All previous widgets + new Ferry & Flight widgets)

    function FerryScheduleWidget() {
      const [route, setRoute] = useState('VYPIN');
      const [ferries, setFerries] = useState(MOCK_FERRIES['VYPIN']);

      useEffect(() => setFerries(MOCK_FERRIES[route]), [route]);

      return h('div', { className: "bg-slate-900 rounded-3xl border border-slate-700 p-6 h-full flex flex-col" },
        h('h3', { className: "font-bold tracking-wider mb-6" }, "⛴️ Ferry Schedule"),
        h('select', { value: route, onChange: e => setRoute(e.target.value), className: "bg-slate-800 border border-slate-700 rounded-2xl px-4 py-3 mb-6 w-full" },
          FERRY_ROUTES.map(r => h('option', { key: r.id, value: r.id }, r.code))
        ),
        h('div', { className: "flex-1 overflow-auto custom-scrollbar space-y-3" },
          ferries.map((f,i) => h('div', { key: i, className: "bg-slate-800/70 rounded-2xl p-5" },
            h('div', { className: "flex justify-between" },
              h('div', { className: "font-semibold" }, f.time),
              h('div', { className: "text-emerald-400" }, f.duration)
            ),
            h('div', { className: "text-sm text-slate-400" }, f.type)
          ))
        )
      );
    }

    function FlightWidget() {
      return h('div', { className: "bg-slate-900 rounded-3xl border border-slate-700 p-6 h-full" },
        h('h3', { className: "font-bold tracking-wider mb-6" }, "✈️ Flight Status"),
        h('div', { className: "space-y-4" },
          MOCK_FLIGHTS.map((f,i) => h('div', { key: i, className: "flex justify-between items-center bg-slate-800/70 rounded-2xl p-4" },
            h('div', null,
              h('div', { className: "font-mono" }, f.flight),
              h('div', { className: "text-sm text-slate-400" }, f.route)
            ),
            h('div', { className: `px-4 py-1 rounded-full text-xs ${f.status === 'On Time' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-orange-500/20 text-orange-400'}` }, f.status)
          ))
        )
      );
    }

    // MoviesWidget, TrainScheduleWidget, BusScheduleWidget, etc. remain from previous version (expanded)

    // ==================== MAIN DASHBOARD ====================
    function Dashboard({ user, onLogout }) {
      return h(Fragment, null,
        h(Header, { user, onLogout }),
        h('div', { className: "max-w-7xl mx-auto p-6" },
          h('div', { className: "grid grid-cols-1 lg:grid-cols-12 gap-6" },
            h('div', { className: "lg:col-span-8 lg:row-span-2" }, h(NewsWidget)),
            h('div', { className: "lg:col-span-4" }, h(GoldTracker)),
            h('div', { className: "lg:col-span-4" }, h(WeatherWidget)),
            h('div', { className: "lg:col-span-4" }, h(TrainScheduleWidget)),
            h('div', { className: "lg:col-span-4" }, h(BusScheduleWidget)),
            h('div', { className: "lg:col-span-4" }, h(FerryScheduleWidget)),
            h('div', { className: "lg:col-span-4" }, h(FlightWidget)),
            h('div', { className: "lg:col-span-6" }, h(MoviesWidget)),
            h('div', { className: "lg:col-span-6" }, h(ChartsWidget))
          )
        )
      );
    }

    // AuthPage and App remain the same as before

    function App() {
      const { user, login, logout, isLoading } = useContext(AuthContext);
      if (isLoading) return h('div', { className: "min-h-screen flex items-center justify-center" }, h('div', { className: "w-12 h-12 border-4 border-red-500 border-t-transparent rounded-full animate-spin" }));
      return h(Fragment, null,
        user ? h(Dashboard, { user, onLogout: logout }) : h(AuthPage, { onLogin: login }),
        h(ToastContainer)
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(
      h(ThemeProvider, null,
        h(AuthProvider, null,
          h(App)
        )
      )
    );
  </script>
